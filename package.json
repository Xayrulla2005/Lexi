{
  "name": "lex-dispatcher",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:packages": "pnpm --filter @lex/contracts --filter @lex/legal-engine --filter @lex/ai build",
    "gen:contracts": "node packages/contracts/scripts/generate-catalog.mjs",
    "dev:api": "pnpm --filter @lex/api dev",
    "dev:web": "pnpm --filter @lex/web dev",
    "dev:bot": "pnpm --filter @lex/bot dev",
    "mock": "prism mock docs/api/openapi.yaml -p 4010",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm build:packages && pnpm -r typecheck",
    "test": "pnpm build:packages && pnpm -r test",
    "build": "pnpm -r build",
    "import:data": "pnpm --filter @lex/data-import start",
    "eval:ai": "pnpm --filter @lex/ai eval",
    "rag:sources": "pnpm --filter @lex/ai rag:sources"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@stoplight/prism-cli": "^5.12.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0"
  }
}
