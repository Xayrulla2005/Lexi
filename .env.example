# Nusxa oling: cp .env.example .env  (haqiqiy .env repoga tushmaydi)

# Ma'lumotlar bazasi va navbat
DATABASE_URL=postgresql://lex:lex@localhost:5432/lex
REDIS_URL=redis://localhost:6379

# API
API_PORT=3001
# Demoda 1 kun = DEMO_SPEED millisekund (1000 = 1 soniya)
DEMO_SPEED=1000

# AI (Jayhun to'ldiradi)
LLM_API_KEY=
LLM_MODEL_FAST=
LLM_MODEL_STRONG=
EMBEDDING_MODEL=
STT_API_KEY=

# Telegram bot (Dilfuza va Xayrulla)
TELEGRAM_BOT_TOKEN=

# Veb va bot API manzili (mock: http://localhost:4010)
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
