# Copy to .env and fill in locally:  cp .env.example .env
# Nusxa oling: cp .env.example .env  (haqiqiy .env repoga tushmaydi)
# Never commit real values. All values below are placeholders.

# --- Runtime ---
NODE_ENV=development
PORT=3001
CORS_ORIGIN=http://localhost:3000

# --- Database (optional for now; API runs in-memory when empty) ---
# Example for docker-compose: postgresql://lex:lex@localhost:5432/lex
DATABASE_URL=

# --- AI: LLM provider selection ---
# Which classifier the pipeline uses: gemini | huggingface | keyword (default keyword).
# Empty / unset ⇒ offline keyword classifier (analysis is marked "degraded").
LLM_PROVIDER=gemini

# --- AI: Google Gemini (active in MVP) ---
# Key from Google AI Studio; process.env only, never logged or committed.
GEMINI_API_KEY=
# Note: gemini-2.5-flash-lite is retired for new users — use the 3.5 line.
GEMINI_MODEL=gemini-3.5-flash-lite

# --- AI: Hugging Face Inference (fallback provider) ---
HF_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
HF_EMBEDDING_MODEL=BAAI/bge-m3
HF_STT_MODEL=openai/whisper-large-v3

# --- Mock agency simulator ---
# Unset (default): MANUAL clock — simulated time moves only with the cabinet button
# "⏩ Vaqtni oldinga surish (+15 kun)"; nothing becomes OVERDUE by itself.
# Set: AUTO clock, 1 simulated "day" in milliseconds (1000 = 1 second).
# DEMO_SPEED=1000
# Simulated response deadline in days. A configuration value, NOT a legal term from the catalog.
SIM_RESPONSE_DAYS=15

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=

# --- Client → API base URL (Prism mock: http://localhost:4010) ---
API_URL=http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001
